# Copy to .env.local. Nothing here is required: the app runs on mock data and every URL has a default.

# Serve the app at the root instead of /app on Vercel (only once it has its own domain).
# APP_BASE_PATH=

# Canonical URLs (optional) — src/lib/site.ts.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_LANDING_URL=http://localhost:3002
