# Copy to .env.local. Nothing here is required: every value has a default.

# Boluck API, including /api/v1 (default: the Railway deployment). The app's origin must be allowed in the
# backend's FRONTEND_URL / CORS_ORIGINS.
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# WalletConnect (Reown) project id for Varial Mobile — src/features/wallet/kit.ts has a default.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Run the in-browser simulation on seed data instead of the API and real wallets.
# NEXT_PUBLIC_DEMO_MODE=1

# Serve the app at the root instead of /app on Vercel (only once it has its own domain).
# APP_BASE_PATH=

# Canonical URLs (optional) — src/lib/site.ts.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_LANDING_URL=http://localhost:3002
