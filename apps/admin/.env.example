# Copy to .env.local. Nothing here is required.

# The backend the same-origin proxy forwards `/api/v1/*` to (next.config.ts). Default: the Railway deployment.
# API_PROXY_TARGET=http://localhost:4000

# WalletConnect (Reown) project id for Varial Mobile — src/features/wallet/kit.ts has a default.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Serve the console at the root instead of /admin on Vercel (only once it has its own domain).
# ADMIN_BASE_PATH=
